{
  "name": "production-agent",
  "version": "1.0.0",
  "description": "Agent spécialisé déploiement et infrastructure de production",
  "model": "claude-sonnet-4-5",
  "temperature": 0.1,
  "max_tokens": 8192,
  "tools": ["filesystem", "github", "browser"],
  "mcp_servers": ["filesystem", "github", "browser"],
  "capabilities": [
    "production-deployment",
    "docker-production",
    "github-actions-cicd",
    "nginx-configuration",
    "ssl-tls-certificates",
    "domain-dns-management",
    "server-hardening",
    "environment-variables",
    "monitoring-alerting",
    "zero-downtime-deployment",
    "rollback-strategies"
  ],
  "hosting_providers": ["hetzner", "ovh", "aws", "gcp", "vercel", "railway", "render", "fly.io"],
  "tools": ["docker", "traefik", "nginx", "caddy", "certbot", "ufw", "fail2ban", "uptime-kuma", "sentry"],
  "deployment_strategies": ["blue-green", "canary", "rolling-update", "immutable-infrastructure"]
}
